#!/usr/bin/env bash
# ===================================================================
# Minimal Font Switcher - Curated Pure Monospace Coding Typography
# Switches Kitty (Minimal instance) and Neovim fonts on-the-fly!
# Leaves host terminal configuration (kitty.conf) 100% untouched.
# ===================================================================

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
PURPLE="\033[1;35m"
GRAY="\033[0;90m"
BOLD="\033[1m"
RESET="\033[0m"

# Font definitions: [key]="Family Name:Optimal Size:Flavor Description"
declare -A FONTS=(
  # Modern & Engineering
  ["1"]="JetBrains Mono:11.5:High x-height, razor-sharp rectangular geometry, developer favorite"
  ["2"]="Geist Mono:11.5:Vercel's ultra-clean modern engineering monospace"
  ["3"]="Intel One Mono:11.5:Intel Labs engineered for maximum distinction & clarity"
  ["4"]="Fira Code:11.5:Iconic clean geometry and famous programming ligatures"
  ["5"]="Cascadia Code:11.5:Microsoft's modern terminal font with smooth ligatures"
  ["6"]="Red Hat Mono:11.5:Clean, modern corporate geometric Linux monospace"

  # Architectural & Minimalist
  ["7"]="Iosevka:12.0:Ultra-compact, tall & slender architectural coding font"
  ["8"]="CommitMono:11.5:Eigil Nikolajsen's neutral, anonymous, distraction-free monospace"
  ["9"]="Hack:11.5:Crisp, punchy punctuation & deep optical balance (Bitstream legacy)"
  ["10"]="IBM Plex Mono:11.5:Engineered by IBM: technical precision meets humanist curves"
  ["11"]="0xProto:11.5:0xType high-contrast ligatures & distinctive zero"

  # Curated Scripts & Cursive Italics
  ["12"]="Victor Mono:11.5:Famous semi-connected cursive script italics & crisp roman glyphs"
  ["13"]="Fantasque Sans Mono:12.0:Whimsical story-book cursive loops & distinct character"
  ["14"]="Maple Mono:11.5:Rounded humanist font with retro charm and cursive italics"

  # Cyberpunk, Retro & Brutalist
  ["15"]="Departure Mono:11.0:Helena Zhang's 80s arcade pixel-meets-terminal monospace"
  ["16"]="Martian Mono:11.0:Evil Martians brutalist technical geometric monospace"
  ["17"]="Space Mono:11.5:Retro-futuristic geometric monospace with typewriter warmth"
  ["18"]="Hermit:11.5:Pablo Caro's geometric hacker font designed by and for coders"
  ["19"]="Anonymous Pro:12.0:Mark Simonson's classic fixed-width hacker aesthetic"

  # GitHub Monaspace Superfamily
  ["20"]="Monaspace Neon:11.5:GitHub's crisp modern neo-grotesque monospace"
  ["21"]="Monaspace Radon:11.5:GitHub's historical handwritten script monospace"
  ["22"]="Monaspace Xenon:11.5:GitHub's vintage flared-serif press monospace"
  ["23"]="Monaspace Krypton:11.5:GitHub's futuristic mechanical command monospace"
  ["24"]="Monaspace Argon:11.5:GitHub's humanistic wide-open geometric monospace"

  # Timeless Classics
  ["25"]="Inconsolata:12.5:Raph Levien's classic slender typewriter proportions"
  ["26"]="Ubuntu Mono:12.0:Warm, rounded, distinct humanist lowercase & punctuation"
  ["27"]="Adwaita Mono:11.5:GNOME's crisp modern default monospace"
)

# Aliases for quick CLI usage (e.g. `minimal-font geist` or `minimal font iosevka`)
declare -A ALIASES=(
  ["jetbrains"]="1"
  ["jetbrains-mono"]="1"
  ["geist"]="2"
  ["geist-mono"]="2"
  ["intel"]="3"
  ["intel-one"]="3"
  ["fira"]="4"
  ["fira-code"]="4"
  ["cascadia"]="5"
  ["cascadia-code"]="5"
  ["redhat"]="6"
  ["redhat-mono"]="6"
  ["iosevka"]="7"
  ["commit"]="8"
  ["commitmono"]="8"
  ["hack"]="9"
  ["ibm"]="10"
  ["plex"]="10"
  ["ibm-plex"]="10"
  ["proto"]="11"
  ["0xproto"]="11"
  ["victor"]="12"
  ["victor-mono"]="12"
  ["fantasque"]="13"
  ["maple"]="14"
  ["departure"]="15"
  ["martian"]="16"
  ["space"]="17"
  ["space-mono"]="17"
  ["hermit"]="18"
  ["anon"]="19"
  ["anonymous"]="19"
  ["neon"]="20"
  ["radon"]="21"
  ["xenon"]="22"
  ["krypton"]="23"
  ["argon"]="24"
  ["inconsolata"]="25"
  ["ubuntu"]="26"
  ["adwaita"]="27"
)

apply_font() {
  local entry="$1"
  local name="$(echo "$entry" | cut -d':' -f1)"
  local size="$(echo "$entry" | cut -d':' -f2)"
  local desc="$(echo "$entry" | cut -d':' -f3)"

  echo -e "\n${GREEN}✔ Applying:${RESET} ${BOLD}${name}${RESET} (${size}pt)"
  echo -e "  ${PURPLE}Vibe:${RESET} ${desc}\n"

  # 1. Update ~/.config/kitty/minimal.conf (Dedicated Minimal window ONLY - leaves kitty.conf untouched!)
  local KITTY_MIN="$HOME/.config/kitty/minimal.conf"
  if [ -f "$KITTY_MIN" ]; then
    sed -i -E "s/^[# ]*font_family[[:space:]]+.*/font_family      ${name}/" "$KITTY_MIN"
    sed -i -E "s/^[# ]*font_size[[:space:]]+.*/font_size        ${size}/" "$KITTY_MIN"
  fi

  # 2. Update minimal-code-editor repo kitty config
  local REPO_MIN="$HOME/Projects/minimal-code-editor/config/kitty/minimal.conf"
  if [ -f "$REPO_MIN" ]; then
    sed -i -E "s/^[# ]*font_family[[:space:]]+.*/font_family      ${name}/" "$REPO_MIN"
    sed -i -E "s/^[# ]*font_size[[:space:]]+.*/font_size        ${size}/" "$REPO_MIN"
  fi

  # 3. Update ~/.config/vsc/lua/options.lua
  local VSC_OPT="$HOME/.config/vsc/lua/options.lua"
  if [ -f "$VSC_OPT" ]; then
    sed -i -E "s/^[# ]*opt\.guifont[[:space:]]*=.*/opt.guifont = \"${name}:h${size}\"/" "$VSC_OPT"
  fi

  # 4. Update repo options.lua
  local REPO_OPT="$HOME/Projects/minimal-code-editor/config/vsc/lua/options.lua"
  if [ -f "$REPO_OPT" ]; then
    sed -i -E "s/^[# ]*opt\.guifont[[:space:]]*=.*/opt.guifont = \"${name}:h${size}\"/" "$REPO_OPT"
  fi

  # 5. Hot-reload any running Minimal Kitty instances without disturbing user's main terminal
  pkill -USR1 -f "kitty.*--class[ =]vsc" 2>/dev/null || true

  echo -e "${GREEN}✨ Font updated! Launch Minimal editor with 'minimal' to enjoy ${BOLD}${name}${RESET}${GREEN}.${RESET}"
}

CHOICE="$1"

if [ -n "$CHOICE" ]; then
  # Direct match or alias
  LOWER="$(echo "$CHOICE" | tr '[:upper:]' '[:lower:]')"
  if [ -n "${ALIASES[$LOWER]}" ]; then
    CHOICE="${ALIASES[$LOWER]}"
  fi

  # Check by exact name match
  if [ -z "${FONTS[$CHOICE]}" ]; then
    for k in "${!FONTS[@]}"; do
      f_name="$(echo "${FONTS[$k]}" | cut -d':' -f1 | tr '[:upper:]' '[:lower:]')"
      if [ "$f_name" = "$LOWER" ]; then
        CHOICE="$k"
        break
      fi
    done
  fi

  if [ -n "${FONTS[$CHOICE]}" ]; then
    apply_font "${FONTS[$CHOICE]}"
    exit 0
  else
    echo -e "${YELLOW}Unknown font selection: '$CHOICE'${RESET}"
    echo -e "Run ${CYAN}minimal font${RESET} without arguments to see all available fonts."
    exit 1
  fi
fi

# Interactive menu
print_section() {
  local title="$1"
  shift
  echo -e "\n  ${PURPLE}${BOLD}── ${title} ──────────────────────────────────────────────────${RESET}"
  for i in "$@"; do
    entry="${FONTS[$i]}"
    name="$(echo "$entry" | cut -d':' -f1)"
    size="$(echo "$entry" | cut -d':' -f2)"
    desc="$(echo "$entry" | cut -d':' -f3)"
    printf "   ${GREEN}%2d)${RESET} ${BOLD}%-21s${RESET} ${BLUE}(%4s pt)${RESET}  ${GRAY}%s${RESET}\n" "$i" "$name" "$size" "$desc"
  done
}

echo -e "${CYAN}${BOLD}"
echo "  ╔═══════════════════════════════════════════════════════════════════════╗"
echo "  ║        ⚡ Minimal Code Editor - Pure Geek Typography Gallery         ║"
echo "  ║            (27 Pure Monospaced Fonts • 0% Nerd Fonts)                 ║"
echo "  ╚═══════════════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"

print_section "Modern & Engineering" 1 2 3 4 5 6
print_section "Architectural & Minimalist" 7 8 9 10 11
print_section "Curated Scripts & Cursive Italics" 12 13 14
print_section "Cyberpunk, Retro & Brutalist" 15 16 17 18 19
print_section "GitHub Monaspace Superfamily" 20 21 22 23 24
print_section "Timeless Classics" 25 26 27

echo ""
read -p "  Select font number (1-27) or type name/alias (or Ctrl+C): " INPUT

if [ -z "$INPUT" ]; then
  exit 0
fi

INPUT_LOWER="$(echo "$INPUT" | tr '[:upper:]' '[:lower:]')"
if [ -n "${ALIASES[$INPUT_LOWER]}" ]; then
  INPUT="${ALIASES[$INPUT_LOWER]}"
fi

# Check by exact name match
if [ -z "${FONTS[$INPUT]}" ]; then
  for k in "${!FONTS[@]}"; do
    f_name="$(echo "${FONTS[$k]}" | cut -d':' -f1 | tr '[:upper:]' '[:lower:]')"
    if [ "$f_name" = "$INPUT_LOWER" ]; then
      INPUT="$k"
      break
    fi
  done
fi

if [ -n "${FONTS[$INPUT]}" ]; then
  apply_font "${FONTS[$INPUT]}"
else
  echo -e "\n${YELLOW}Invalid selection.${RESET}"
  exit 1
fi
