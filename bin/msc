#!/usr/bin/env bash
# ===================================================================
# Minimal Code Editor - Wrapper Engine
# ===================================================================
set -e

export NVIM_APPNAME="vsc"

# Self-updater: minimal update / minimal --update
if [ "$1" = "update" ] || [ "$1" = "--update" ]; then
    echo "⚡ Updating Minimal Code Editor to the latest version..."
    curl -fsSL https://raw.githubusercontent.com/utkarshIsAProgrammer/minimal-code-editor/main/install.sh | bash
    exit 0
fi

# Font selector: minimal font / minimal --font / minimal fonts
if [ "$1" = "font" ] || [ "$1" = "--font" ] || [ "$1" = "fonts" ]; then
    shift
    DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -x "$DIR/minimal-font" ]; then
        exec "$DIR/minimal-font" "$@"
    elif command -v minimal-font >/dev/null 2>&1; then
        exec minimal-font "$@"
    elif [ -x "$HOME/.local/bin/minimal-font" ]; then
        exec "$HOME/.local/bin/minimal-font" "$@"
    fi
fi

# Locate Neovim binary across standard Unix / macOS paths
NVIM_BIN=""
if command -v nvim >/dev/null 2>&1; then
    NVIM_BIN="nvim"
elif [ -x "/opt/homebrew/bin/nvim" ]; then
    NVIM_BIN="/opt/homebrew/bin/nvim"
elif [ -x "/usr/local/bin/nvim" ]; then
    NVIM_BIN="/usr/local/bin/nvim"
elif [ -x "$HOME/.local/bin/nvim" ]; then
    NVIM_BIN="$HOME/.local/bin/nvim"
fi

if [ -z "$NVIM_BIN" ]; then
    echo "Error: 'nvim' (Neovim) was not found in your PATH." >&2
    echo "Please install Neovim (>=0.9.0) from https://neovim.io" >&2
    exit 1
fi

KITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/minimal.conf"

# Check for Kitty in PATH or macOS Applications
KITTY_BIN=""
if command -v kitty >/dev/null 2>&1; then
    KITTY_BIN="kitty"
elif [ -x "/Applications/kitty.app/Contents/MacOS/kitty" ]; then
    KITTY_BIN="/Applications/kitty.app/Contents/MacOS/kitty"
fi

# Check for Ghostty in PATH or macOS Applications
GHOSTTY_BIN=""
if command -v ghostty >/dev/null 2>&1; then
    GHOSTTY_BIN="ghostty"
elif [ -x "/Applications/Ghostty.app/Contents/MacOS/ghostty" ]; then
    GHOSTTY_BIN="/Applications/Ghostty.app/Contents/MacOS/ghostty"
fi

# Check if already running inside Minimal's embedded terminal
if [ -n "$NVIM" ]; then
    if [ $# -eq 0 ]; then
        "$NVIM_BIN" --server "$NVIM" --remote-expr "v:lua._G.FocusEditorFromTerminal()" >/dev/null 2>&1
        exit 0
    fi
    for arg in "$@"; do
        case "$arg" in
            -h|--help|-v|--version)
                exec "$NVIM_BIN" "$arg"
                ;;
            -*)
                ;;
            *)
                FULL_PATH="$(realpath "$arg" 2>/dev/null || readlink -f "$arg" 2>/dev/null || echo "$PWD/$arg")"
                ESCAPED="${FULL_PATH//\'/\\\'}"
                "$NVIM_BIN" --server "$NVIM" --remote-expr "v:lua._G.OpenFileFromTerminal('$ESCAPED')" >/dev/null 2>&1
                ;;
        esac
    done
    exit 0
fi

# Terminal Launcher Logic:
# 1. If already inside Kitty or Ghostty, execute Neovim directly in the current terminal window.
# 2. If outside, prefer Kitty with Minimal's dedicated profile.
# 3. If Kitty is not present, use Ghostty.
# 4. If launched from GUI/desktop without a terminal (! [ -t 0 ]), find any installed graphical terminal emulator.
# 5. Otherwise, run in the current shell.
if [ -z "$KITTY_WINDOW_ID" ] && [ -z "$GHOSTTY_RESOURCES_DIR" ]; then
    if [ -n "$KITTY_BIN" ]; then
        if [ -f "$KITTY_CONF" ]; then
            exec "$KITTY_BIN" --config "$KITTY_CONF" --class vsc -T "Minimal" -- "$NVIM_BIN" "$@"
        else
            exec "$KITTY_BIN" --class vsc -T "Minimal" -- "$NVIM_BIN" "$@"
        fi
    elif [ -n "$GHOSTTY_BIN" ]; then
        exec "$GHOSTTY_BIN" --title="Minimal" --class="vsc" -e "$NVIM_BIN" "$@"
    elif ! [ -t 0 ]; then
        for term in wezterm alacritty /Applications/WezTerm.app/Contents/MacOS/wezterm /Applications/Alacritty.app/Contents/MacOS/alacritty foot konsole gnome-terminal xfce4-terminal x-terminal-emulator xterm; do
            if command -v "$term" >/dev/null 2>&1 || [ -x "$term" ]; then
                exec "$term" -e "$NVIM_BIN" "$@"
            fi
        done
    fi
fi

exec "$NVIM_BIN" "$@"
