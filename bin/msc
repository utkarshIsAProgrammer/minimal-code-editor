#!/usr/bin/env bash
# ===================================================================
# Minimal Code Editor - Wrapper Engine
# ===================================================================
set -e

export NVIM_APPNAME="vsc"

# Self-updater: minimal update / minimal --update
if [ "$1" = "update" ] || [ "$1" = "--update" ]; then
    echo "⚡ Updating Minimal Code Editor to the latest version..."
    curl -fsSL https://raw.githubusercontent.com/utkarshIsAProgrammer/minimal-code-editor/main/install.sh | bash
    exit 0
fi

# Locate Neovim binary across standard Unix / macOS paths
NVIM_BIN=""
if command -v nvim >/dev/null 2>&1; then
    NVIM_BIN="nvim"
elif [ -x "/opt/homebrew/bin/nvim" ]; then
    NVIM_BIN="/opt/homebrew/bin/nvim"
elif [ -x "/usr/local/bin/nvim" ]; then
    NVIM_BIN="/usr/local/bin/nvim"
elif [ -x "$HOME/.local/bin/nvim" ]; then
    NVIM_BIN="$HOME/.local/bin/nvim"
fi

if [ -z "$NVIM_BIN" ]; then
    echo "Error: 'nvim' (Neovim) was not found in your PATH." >&2
    echo "Please install Neovim (>=0.9.0) from https://neovim.io" >&2
    exit 1
fi

KITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/minimal.conf"

# Check for Kitty in PATH or macOS Applications
KITTY_BIN=""
if command -v kitty >/dev/null 2>&1; then
    KITTY_BIN="kitty"
elif [ -x "/Applications/kitty.app/Contents/MacOS/kitty" ]; then
    KITTY_BIN="/Applications/kitty.app/Contents/MacOS/kitty"
fi

# Launch in Kitty if available and not already inside a Kitty window
if [ -n "$KITTY_BIN" ] && [ -z "$KITTY_WINDOW_ID" ] && [ -t 0 ]; then
    if [ -f "$KITTY_CONF" ]; then
        exec "$KITTY_BIN" --config "$KITTY_CONF" --class vsc -T "Minimal" -- "$NVIM_BIN" "$@"
    else
        exec "$KITTY_BIN" --class vsc -T "Minimal" -- "$NVIM_BIN" "$@"
    fi
else
    exec "$NVIM_BIN" "$@"
fi
