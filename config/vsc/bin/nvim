#!/usr/bin/env bash
# ===================================================================
# Minimal Code Editor - Terminal Client Wrapper
# Prevents nested Neovim inside Minimal Editor's terminal and opens
# files in the active parent editor instance.
# ===================================================================

NVIM_CLI=""
if [ -x "/usr/bin/nvim" ]; then
    NVIM_CLI="/usr/bin/nvim"
elif [ -x "/opt/homebrew/bin/nvim" ]; then
    NVIM_CLI="/opt/homebrew/bin/nvim"
elif [ -x "/usr/local/bin/nvim" ]; then
    NVIM_CLI="/usr/local/bin/nvim"
else
    NVIM_CLI="nvim"
fi

if [ -n "$NVIM" ]; then
    if [ $# -eq 0 ]; then
        "$NVIM_CLI" --server "$NVIM" --remote-expr "v:lua._G.FocusEditorFromTerminal()" >/dev/null 2>&1
        exit 0
    fi

    for arg in "$@"; do
        case "$arg" in
            -h|--help|-v|--version)
                exec "$NVIM_CLI" "$arg"
                ;;
            -*)
                ;;
            *)
                FULL_PATH="$(realpath "$arg" 2>/dev/null || readlink -f "$arg" 2>/dev/null || echo "$PWD/$arg")"
                ESCAPED="${FULL_PATH//\'/\\\'}"
                "$NVIM_CLI" --server "$NVIM" --remote-expr "v:lua._G.OpenFileFromTerminal('$ESCAPED')" >/dev/null 2>&1
                ;;
        esac
    done
    exit 0
fi

exec "$NVIM_CLI" "$@"
