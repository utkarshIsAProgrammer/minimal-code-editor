#!/usr/bin/env bash
# ===================================================================
# Minimal Code Editor - Terminal Client Wrapper
# Prevents nested Neovim inside Minimal Editor's terminal and opens
# files in the active parent editor instance.
# ===================================================================

if [ -n "$NVIM" ]; then
    REAL_NVIM=$(which -a nvim 2>/dev/null | grep -v "/\.config/vsc/bin" | grep -v "/config/vsc/bin" | head -n 1)
    if [ -z "$REAL_NVIM" ]; then
        REAL_NVIM="nvim"
    fi

    if [ $# -eq 0 ]; then
        "$REAL_NVIM" --server "$NVIM" --remote-send "<Esc>:lua _G.FocusEditorFromTerminal()<CR>" >/dev/null 2>&1
        exit 0
    fi

    for arg in "$@"; do
        case "$arg" in
            -h|--help|-v|--version)
                exec "$REAL_NVIM" "$arg"
                ;;
            -*)
                ;;
            *)
                FULL_PATH="$(realpath "$arg" 2>/dev/null || readlink -f "$arg" 2>/dev/null || echo "$PWD/$arg")"
                ESCAPED="${FULL_PATH//\'/\\\'}"
                "$REAL_NVIM" --server "$NVIM" --remote-send "<Esc>:lua _G.OpenFileFromTerminal('$ESCAPED')<CR>" >/dev/null 2>&1
                ;;
        esac
    done
    exit 0
fi

REAL_NVIM=$(which -a nvim 2>/dev/null | grep -v "/\.config/vsc/bin" | grep -v "/config/vsc/bin" | head -n 1)
exec "$REAL_NVIM" "$@"
